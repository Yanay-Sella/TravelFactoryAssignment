# Copy to .env and adjust if needed. Defaults match docker-compose.yml.

# --- Common Event Framework ---
LAMBDA_NAME=vacation-api
ALIAS=dev
FRONT_END_URL=http://localhost:5173

# --- Database (TypeORM) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vacation
DB_USER=vacation
DB_PASSWORD=vacation

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
